    private void pune_la_cos() {

        ridica3.setDirection(DcMotor.Direction.FORWARD);
        ridica3.setTargetPosition(900);
        ridica3.setMode(DcMotor.RunMode.RUN_TO_POSITION);
        ridica3.setPower(1);
        timp.reset();
        while (timp.milliseconds() < 800 && opModeIsActive()) {
            puneLaCosDone = false;
        }
        ridica3.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        timp.reset();
        pgrip.setPower(-0.3); // eliberam elementul
        rgrip.setPower(0.3);
        timp.reset();
        while (timp.milliseconds() < 400 && opModeIsActive()) {
            puneLaCosDone = false;
        }
        rgrip.setPower(0);
        pgrip.setPower(0);
        timp.reset();
        while (timp.milliseconds() < 400 && opModeIsActive()) {
            puneLaCosDone = false;
        }
        ridica3.setDirection(DcMotor.Direction.REVERSE);
        ridica3.setTargetPosition(0);
        ridica3.setMode(DcMotor.RunMode.RUN_TO_POSITION);
        ridica3.setPower(1);
        ridica3.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        while (timp.milliseconds() < 500 && opModeIsActive()) {
            puneLaCosDone = false;
        }
        puneLaCosDone = true;

    }


    private void delayAndRun(long delayMillis, Runnable action) {
        // Run the action after a delay using a new thread
        new Thread(() -> {
            try {
                Thread.sleep(delayMillis); // Sleep for the delay duration
                action.run(); // Execute the action after the delay
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt(); // Restore the interrupted status
            }
        }).start();
    }

    private void prinde_elem() {
        ridica3.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
        gripperTimer.reset();
        while(gripperTimer.milliseconds() <= 3000 && digitalTouch.getState())
        {
            pgrip.setPower(0.5);
            rgrip.setPower(-0.5);
            ridica3.setDirection(DcMotor.Direction.FORWARD);
            ridica3.setTargetPosition(1380);
            ridica3.setMode(DcMotor.RunMode.RUN_TO_POSITION);
            ridica3.setPower(0.6);
            int currentPos = ridica3.getCurrentPosition();
            double gripperPosition = START_GRIPPER_POSITION + (currentPos / (double) MAX_EXTENSION) * (END_GRIPPER_POSITION - START_GRIPPER_POSITION);
            // Continuously update servo positions
            rotatie1.setPosition(gripperPosition);
            rotatie2.setPosition(gripperPosition);
        }
        gripperTimer.reset();
        while(gripperTimer.milliseconds() <= 1000)
        {
            pgrip.setPower(0);
            rgrip.setPower(0);
            rotatie1.setPosition(0.2);
            rotatie2.setPosition(0.2);
            ridica3.setDirection(DcMotor.Direction.REVERSE);
            ridica3.setTargetPosition(0);
            ridica3.setMode(DcMotor.RunMode.RUN_TO_POSITION);
            ridica3.setPower(0.9);
        }
        griper_vertical = false;

    }
    /**
     * Calculate the elapsed time in seconds since the last update.
     */
    private double getDeltaTime() {
        long currentTime = System.currentTimeMillis();
        double deltaTime = (currentTime - lastUpdateTime) / 1000.0;
        return deltaTime == 0 ? 0.02 : deltaTime; // Default to 20ms if deltaTime is 0
    }


    public void ridica_brat() {
        while (!puneLaCosDone && opModeIsActive()) {
            // Get current position
            int currentPosition = ridica1.getCurrentPosition();
            int pozitie = -currentPosition;

            // Calculate PIDF output
            double error = targetPosition - pozitie;
            integralSum += error * getDeltaTime();
            double derivative = (error - lastError) / getDeltaTime();
            double output = kP * error + kI * integralSum + kD * derivative + kF;

            // Apply power to motors (clamped to [-1, 1])
            double clampedPower = Math.max(-1.0, Math.min(1.0, output));
            ridica1.setPower(-clampedPower);
            ridica2.setPower(-clampedPower);

            // Update telemetry for monitoring
            telemetry.addData("Target Position", targetPosition);
            telemetry.addData("Current Position", currentPosition);
            telemetry.addData("Error", error);
            telemetry.addData("Integral Sum", integralSum);
            telemetry.addData("Derivative", derivative);
            telemetry.addData("Motor Power", clampedPower);
            telemetry.addData("Holding Target Position", targetReached);
            telemetry.update();

            // Update last error and time
            lastError = error;
            lastUpdateTime = System.currentTimeMillis();


            if(!griper_vertical && Math.abs(currentPosition)>150)
            {
                rotatie1.setPosition(0.61);
                rotatie2.setPosition(0.61);
                griper_vertical = true;
            }

            // Yield control to allow other threads to execute
            try {
                Thread.sleep(10); // Small delay to allow other tasks to run
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
                break; // Exit if the thread is interrupted
            }
        }
    }

    public void coboara_brat_withRunToPosition() {
        // Set the target position for both motors to 0 (initial position)
        ridica1.setTargetPosition(0);
        ridica2.setTargetPosition(0);

        // Ensure motors are in RUN_TO_POSITION mode
        ridica1.setMode(DcMotor.RunMode.RUN_TO_POSITION);
        ridica2.setMode(DcMotor.RunMode.RUN_TO_POSITION);

        // Set the motor power (this controls the speed of movement)
        double power = 0.2; // Increased speed for faster lowering
        ridica1.setPower(power);
        ridica2.setPower(power);
        rotatie1.setPosition(0.2);
        rotatie2.setPosition(0.2);

        // Set a timeout of 1 second
        ElapsedTime timer = new ElapsedTime();
        while (opModeIsActive() && timer.milliseconds() < 1500) {
            int pos1 = Math.abs(ridica1.getCurrentPosition());
            int pos2 = Math.abs(ridica2.getCurrentPosition());

            telemetry.addData("Lowering Arm...", "Time: %.2f sec", timer.seconds());
            telemetry.addData("Position ridica1", pos1);
            telemetry.addData("Position ridica2", pos2);
            telemetry.update();

            // Stop early if both motors reach position 20
            if (pos1 <= 20 && pos2 <= 20) {
                break;
            }

            sleep(10); // Prevent CPU overloading
        }

        // Stop the motors once timeout occurs or position is reached
        ridica1.setPower(0);
        ridica2.setPower(0);

        // Reset the motor mode back to RUN_WITHOUT_ENCODER for other operations
        ridica1.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
        ridica2.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
        puneLaCosDone = false;
    }





