    // Helper method to execute two actions in parallel
    private void executeInParallel2(Runnable action1, Runnable action2) {
        // Create two separate threads for the actions
        Thread thread1 = new Thread(action1); // Task 1
        Thread thread2 = new Thread(action2); // Task 2

        // Start both threads
        thread1.start();
        thread2.start();

        // Optionally wait for both threads to finish (join them)
        try {
            thread1.join(); // Wait for Task 1 to finish
            thread2.join(); // Wait for Task 2 to finish
        } catch (InterruptedException e) {
            telemetry.addData("Error", "Thread interrupted: " + e.getMessage());
            telemetry.update();
        }
    }

    private void executeInParallel3(Runnable action1, Runnable action2, Runnable action3) {
        // Create two separate threads for the actions
        Thread thread1 = new Thread(action1); // Task 1
        Thread thread2 = new Thread(action2); // Task 2
        Thread thread3 = new Thread(action3); // Task 2

        // Start both threads
        thread1.start();
        thread2.start();
        thread3.start();

        // Optionally wait for both threads to finish (join them)
        try {
            thread1.join(); // Wait for Task 1 to finish
            thread2.join(); // Wait for Task 2 to finish
            thread3.join(); // Wait for Task 2 to finish
        } catch (InterruptedException e) {
            telemetry.addData("Error", "Thread interrupted: " + e.getMessage());
            telemetry.update();
        }
    }


    private void executeInParallel4(Runnable action1, Runnable action2, Runnable action3, Runnable action4) {
        // Create two separate threads for the actions
        Thread thread1 = new Thread(action1); // Task 1
        Thread thread2 = new Thread(action2); // Task 2
